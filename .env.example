# Microsoft Entra ID / Auth.js (same single-tenant pattern as TGIF)
AUTH_SECRET=                          # generate with: npx auth secret
AUTH_URL=http://localhost:3000
AUTH_MICROSOFT_ENTRA_ID_ID=           # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=       # Client secret value
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=    # Directory (tenant) ID

# SharePoint REST (the same site/user delegated-access model as LeaveApplication)
NEXT_PUBLIC_SHAREPOINT_RESOURCE=https://yourtenant.sharepoint.com
SHAREPOINT_BASE_URL=https://yourtenant.sharepoint.com/sites/yoursite
SHAREPOINT_APPLICATIONS_LIST=AppHubApplications
SHAREPOINT_ADMINS_LIST=AppHubAdmins
